{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dMotion Codex review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_commit",
    "status",
    "conclusion",
    "blocking_findings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "reviewed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "failed"
      ]
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "unavailable"
      ]
    },
    "blocking_findings": {
      "type": "integer",
      "minimum": 0
    }
  }
}
